# Copy to .env (gitignored) and fill in. Used by ./deploy.py
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=username
FTP_PASS=password
# Directory on the FTP server that serves the site (e.g. /, /htdocs, /public_html)
FTP_DIR=/
# 1 = explicit FTPS (FTP over TLS, recommended if the host supports it), 0 = plain FTP
FTP_TLS=1
# Space-separated glob patterns of tracked files NOT to upload
DEPLOY_EXCLUDE=.gitignore .env.example deploy.py README.md
